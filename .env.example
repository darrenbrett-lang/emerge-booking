# Copy to .env.local for development. In Vercel, set these per environment.
SITE_URL=http://localhost:3000

# Supabase project "Emerge Booking" (Settings > API). The service role key is
# server only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Test keys (sk_test_...) until Darren approves go-live.
STRIPE_SECRET_KEY=
# From the webhook endpoint for /api/webhooks/stripe, listening to:
# checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# Resend, with emergeunderground.com verified (SPF, DKIM, DMARC).
RESEND_API_KEY=
EMAIL_FROM="Emerge <hello@emergeunderground.com>"
EMAIL_REPLY_TO=darren@dabhands.delivery

# Long random strings: `openssl rand -hex 32`
CRON_SECRET=
CLIENT_HASH_SALT=

# Local preview only, when Supabase is not connected yet.
# PREVIEW_REMAINING=12
# PREVIEW_PHASE=open
